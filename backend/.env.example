# AdmitGuard Backend Environment Configuration (Template)

# App Settings
PROJECT_NAME="AdmitGuard Intelligence"
API_V1_STR=/api/v1
ENVIRONMENT=development

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database Configuration
DATABASE_URL=postgresql+psycopg://admitguard:admitguard@localhost:5432/admitguard

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# ML Artifacts Paths (Readmission)
READMISSION_MODEL_PATH=ml/artifacts/readmission_model.joblib
READMISSION_PREPROCESSOR_PATH=ml/artifacts/readmission_preprocessor.joblib
READMISSION_FEATURE_SCHEMA_PATH=ml/artifacts/readmission_features.json

# ML Artifacts Paths (Claim)
CLAIM_MODEL_PATH=ml/artifacts/claim_model.joblib
CLAIM_FEATURE_SCHEMA_PATH=ml/artifacts/claim_features.json
CLAIM_METADATA_PATH=ml/artifacts/claim_metadata.json

# Security (Placeholder for JWT)
JWT_SECRET_KEY=change_this_in_production_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520